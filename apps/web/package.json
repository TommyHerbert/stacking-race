{
  "name": "@stacking-race/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cap:sync": "pnpm build && cap sync android",
    "android:sync": "pnpm build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "pnpm android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@stacking-race/engine": "workspace:*",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@preact/preset-vite": "^2.10.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
